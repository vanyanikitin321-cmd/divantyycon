        private void SetupAccessRights()
        {
            if (MainWindow.CurrentUser == null) return;

            string role = MainWindow.CurrentUser.RoleName;

            // Базовые права для всех
            btnViewProducts.IsEnabled = true;

            // Права менеджера и администратора
            if (role == "Manager" || role == "Administrator")
            {
                btnFilteredProducts.IsEnabled = true;
                btnViewOrders.IsEnabled = true;
            }
            else
            {
                btnFilteredProducts.IsEnabled = false;
                btnViewOrders.IsEnabled = false;
            }

            // Права только администратора
            btnManageProducts.IsEnabled = (role == "Administrator");
        }


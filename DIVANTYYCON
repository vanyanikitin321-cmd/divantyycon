using System;
using System.Configuration;
using System.Data;
using System.Data.SqlClient;

namespace WpfApp2
{
    public class DatabaseHelper
    {
        private string connectionString;

        public DatabaseHelper()
        {
            connectionString = ConfigurationManager.ConnectionStrings["FurnitureDB"].ConnectionString;
        }

        public DataTable GetAllProducts()
        {
            string query = @"SELECT p.ProductID, p.ProductName, p.Description, p.Price, 
                           c.CategoryName, s.SupplierName, p.StockQuantity,
                           p.CategoryID, p.SupplierID
                           FROM Products p
                           LEFT JOIN Categories c ON p.CategoryID = c.CategoryID
                           LEFT JOIN Suppliers s ON p.SupplierID = s.SupplierID";

            return ExecuteQuery(query);
        }

        public DataTable GetFilteredProducts(string searchText, string category, string sortBy)
        {
            string query = @"SELECT p.ProductID, p.ProductName, p.Description, p.Price, 
                           c.CategoryName, s.SupplierName, p.StockQuantity
                           FROM Products p
                           LEFT JOIN Categories c ON p.CategoryID = c.CategoryID
                           LEFT JOIN Suppliers s ON p.SupplierID = s.SupplierID
                           WHERE 1=1";

            SqlCommand command = new SqlCommand();

            if (!string.IsNullOrEmpty(searchText))
            {
                query += " AND (p.ProductName LIKE @SearchText OR p.Description LIKE @SearchText)";
                command.Parameters.AddWithValue("@SearchText", "%" + searchText + "%");
            }

            if (!string.IsNullOrEmpty(category) && category != "Все категории")
            {
                query += " AND c.CategoryName = @Category";
                command.Parameters.AddWithValue("@Category", category);
            }

            switch (sortBy)
            {
                case "По названию":
                    query += " ORDER BY p.ProductName";
                    break;
                case "По цене (возрастание)":
                    query += " ORDER BY p.Price ASC";
                    break;
                case "По цене (убывание)":
                    query += " ORDER BY p.Price DESC";
                    break;
                case "По остатку":
                    query += " ORDER BY p.StockQuantity DESC";
                    break;
                default:
                    query += " ORDER BY p.ProductID";
                    break;
            }

            command.CommandText = query;
            return ExecuteCommand(command);
        }

        public DataTable GetCategories()
        {
            string query = "SELECT * FROM Categories ORDER BY CategoryName";
            return ExecuteQuery(query);
        }

        public DataTable GetSuppliers()
        {
            string query = "SELECT * FROM Suppliers ORDER BY SupplierName";
            return ExecuteQuery(query);
        }

        public bool AddProduct(string name, string description, decimal price, 
                               int categoryId, int supplierId, int stock)
        {
            string query = @"INSERT INTO Products (ProductName, Description, Price, 
                           CategoryID, SupplierID, StockQuantity) 
                           VALUES (@Name, @Description, @Price, @CategoryID, 
                                   @SupplierID, @StockQuantity)";

            SqlCommand command = new SqlCommand(query);
            command.Parameters.AddWithValue("@Name", name);
            command.Parameters.AddWithValue("@Description", description);
            command.Parameters.AddWithValue("@Price", price);
            command.Parameters.AddWithValue("@CategoryID", categoryId);
            command.Parameters.AddWithValue("@SupplierID", supplierId);
            command.Parameters.AddWithValue("@StockQuantity", stock);

            return ExecuteNonQuery(command) > 0;
        }

        public bool UpdateProduct(int productId, string name, string description, 
                                  decimal price, int categoryId, int supplierId, int stock)
        {
            string query = @"UPDATE Products 
                           SET ProductName = @Name, Description = @Description, 
                               Price = @Price, CategoryID = @CategoryID, 
                               SupplierID = @SupplierID, StockQuantity = @StockQuantity
                           WHERE ProductID = @ProductID";

            SqlCommand command = new SqlCommand(query);
            command.Parameters.AddWithValue("@ProductID", productId);
            command.Parameters.AddWithValue("@Name", name);
            command.Parameters.AddWithValue("@Description", description);
            command.Parameters.AddWithValue("@Price", price);
            command.Parameters.AddWithValue("@CategoryID", categoryId);
            command.Parameters.AddWithValue("@SupplierID", supplierId);
            command.Parameters.AddWithValue("@StockQuantity", stock);

            return ExecuteNonQuery(command) > 0;
        }

        public bool DeleteProduct(int productId)
        {
            string query = "DELETE FROM Products WHERE ProductID = @ProductID";
            SqlCommand command = new SqlCommand(query);
            command.Parameters.AddWithValue("@ProductID", productId);

            return ExecuteNonQuery(command) > 0;
        }

        public DataTable GetOrders(string statusFilter = null)
        {
            string query = @"SELECT o.OrderID, u.FullName as CustomerName, o.OrderDate, 
                           o.TotalAmount, os.StatusName
                           FROM Orders o
                           INNER JOIN Users u ON o.UserID = u.UserID
                           INNER JOIN OrderStatuses os ON o.StatusID = os.StatusID";

            SqlCommand command = new SqlCommand();

            if (!string.IsNullOrEmpty(statusFilter) && statusFilter != "Все статусы")
            {
                query += " WHERE os.StatusName = @Status";
                command.Parameters.AddWithValue("@Status", statusFilter);
            }

            query += " ORDER BY o.OrderDate DESC";
            command.CommandText = query;

            return ExecuteCommand(command);
        }

        public DataTable GetOrderStatuses()
        {
            string query = "SELECT * FROM OrderStatuses ORDER BY StatusName";
            return ExecuteQuery(query);
        }

        private DataTable ExecuteQuery(string query)
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlDataAdapter adapter = new SqlDataAdapter(query, connection);
                DataTable table = new DataTable();
                adapter.Fill(table);
                return table;
            }
        }

        private DataTable ExecuteCommand(SqlCommand command)
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                command.Connection = connection;
                SqlDataAdapter adapter = new SqlDataAdapter(command);
                DataTable table = new DataTable();
                adapter.Fill(table);
                return table;
            }
        }

        private int ExecuteNonQuery(SqlCommand command)
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                command.Connection = connection;
                connection.Open();
                return command.ExecuteNonQuery();
            }
        }
    }
}



using System.Data;
using System.Windows;

namespace WpfApp2
{
    public partial class ProductViewWindow : Window
    {
        private DatabaseHelper dbHelper;
        private bool showFilters;

        public ProductViewWindow(bool showFilters)
        {
            InitializeComponent();
            dbHelper = new DatabaseHelper();
            this.showFilters = showFilters;

            if (showFilters)
            {
                panelFilters.Visibility = Visibility.Visible;
                LoadFilters();
            }

            LoadProducts();
        }

        private void LoadFilters()
        {
            DataTable categories = dbHelper.GetCategories();
            cmbCategory.Items.Clear();
            cmbCategory.Items.Add("Все категории");
            foreach (DataRow row in categories.Rows)
            {
                cmbCategory.Items.Add(row["CategoryName"].ToString());
            }
            cmbCategory.SelectedIndex = 0;

            cmbSortBy.Items.Clear();
            cmbSortBy.Items.Add("По умолчанию");
            cmbSortBy.Items.Add("По названию");
            cmbSortBy.Items.Add("По цене (возрастание)");
            cmbSortBy.Items.Add("По цене (убывание)");
            cmbSortBy.Items.Add("По остатку");
            cmbSortBy.SelectedIndex = 0;
        }

        private void LoadProducts()
        {
            DataTable products;

            if (showFilters)
            {
                string search = txtSearch.Text.Trim();
                string category = cmbCategory.SelectedItem?.ToString();
                string sortBy = cmbSortBy.SelectedItem?.ToString();
                products = dbHelper.GetFilteredProducts(search, category, sortBy);
            }
            else
            {
                products = dbHelper.GetAllProducts();
            }

            dgvProducts.ItemsSource = products.DefaultView;
        }

        private void btnSearch_Click(object sender, RoutedEventArgs e)
        {
            LoadProducts();
        }

        private void btnClose_Click(object sender, RoutedEventArgs e)
        {
            this.Close();
        }
    }
}


